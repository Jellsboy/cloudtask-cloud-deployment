{
  "name": "cloudtask-cloud-deployment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CloudTask - React + Zustand client-side state management with Express API, CI/CD, monitoring, and cloud deployment support.",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/server.js",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "vite": "8.2.2"
  }
}
